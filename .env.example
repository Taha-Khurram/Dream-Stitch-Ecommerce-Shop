# Supabase Project Configuration
# Replace these values with your Supabase Project Settings -> API credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Session Management
# Minutes of inactivity before a signed-in session is ended. Optional —
# defaults to 30. Server-side only, so it is not exposed to the browser.
SESSION_IDLE_TIMEOUT_MINUTES=30

# ── Transactional email (SMTP) ───────────────────────────────────────────────
# Gmail relay. SMTP_USER must have 2-Step Verification enabled and SMTP_PASS
# must be a 16-character Google App Password — a normal account password is
# rejected with "535-5.7.8 Username and Password not accepted".
# Free Gmail relays ~500 recipients/day (~250 orders, two emails each).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Must be an ADDRESS, not a display name. Either form works:
#   SMTP_FROM=orders@yourdomain.com
#   SMTP_FROM=Dream Stitch by Sk <orders@yourdomain.com>
# Gmail overrides this with SMTP_USER unless it is a verified alias.
SMTP_FROM=
# Where new-order notifications go. Falls back to owner@store.com if unset.
STORE_OWNER_EMAIL=

# ── Server-only Supabase key ─────────────────────────────────────────────────
# Bypasses RLS. Never prefix with NEXT_PUBLIC_ and never import the client that
# reads it (lib/supabase/service.ts) into a Client Component.
SUPABASE_SERVICE_ROLE_KEY=

# ── Payment webhook ──────────────────────────────────────────────────────────
# Signing secret for app/api/webhooks/payment. The route refuses callbacks
# when this is unset rather than skipping verification.
PAYMENT_WEBHOOK_SECRET=
