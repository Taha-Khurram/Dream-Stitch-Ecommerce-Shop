# Supabase Project Configuration
# Replace these values with your Supabase Project Settings -> API credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Session Management
# Minutes of inactivity before a signed-in session is ended. Optional —
# defaults to 30. Server-side only, so it is not exposed to the browser.
SESSION_IDLE_TIMEOUT_MINUTES=30
